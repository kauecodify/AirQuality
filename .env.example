# ===========================================
# AirQuality Monitor - Configuration
# Projeto Integrador III - UNIVESP
# ===========================================

# MongoDB Atlas Connection String
# Get your connection string from: https://www.mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/airquality?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/airquality?retryWrites=true&w=majority

# OpenWeatherMap API Key
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Server Port (default: 3000)
PORT=3000

# Application Environment
NODE_ENV=development

# ===========================================
# Vercel Deployment Configuration
# ===========================================
# For Vercel deployment, add these as environment variables in your project settings:
# - MONGODB_URI
# - OPENWEATHER_API_KEY
# - NODE_ENV=production

# ===========================================
# For Local Development
# ===========================================
# 1. Install dependencies: npm install
# 2. Create .env file with your credentials
# 3. Start server: npm start
# 4. Access: http://localhost:3000
