{
  "name": "airquality-monitor",
  "version": "1.0.0",
  "description": "Plataforma web para monitoramento, visualização e análise de dados de qualidade do ar em tempo real - Projeto Integrador III UNIVESP",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "vercel-build": "npm install && npm run build",
    "build": "echo 'No build required for Node.js backend'",
    "heroku-postbuild": "npm install"
  },
  "keywords": [
    "air-quality",
    "monitoring",
    "iot",
    "express",
    "mongodb",
    "chartjs",
    "leaflet",
    "socket.io",
    "realtime",
    "vercel",
    "univesp",
    "projeto-integrador"
  ],
  "author": "Vera",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "vercel": {
    "version": 2,
    "builds": [
      {
        "src": "src/app.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "src/app.js",
        "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
      }
    ]
  }
}
